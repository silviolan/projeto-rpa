# Copie este arquivo para ".env" (sem o .example) e preencha com a sua chave.
# O .env real esta no .gitignore e NAO deve ser enviado ao GitHub.
#
# Chave gratuita do OpenRouteService (exigida apenas pela acao URBANO):
#   1. crie uma conta em https://openrouteservice.org/dev/#/signup
#   2. gere um token e cole abaixo.
ORS_API_KEY=coloque_sua_chave_aqui
